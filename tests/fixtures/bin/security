#!/usr/bin/env python3
"""A fake `security` (step 12): the probe's keychain check must never reach a real keychain.
It answers like a reachable keychain that has no such item (exit 44) and logs the run."""

import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
with open(HERE / "fake-log.jsonl", "a", encoding="utf-8") as handle:
    entry = {"tool": "security", "argv": sys.argv[1:], "cwd": os.getcwd(), "env": dict(os.environ)}
    handle.write(json.dumps(entry) + "\n")
print("security: SecKeychainSearchCopyNext: The specified item could not be found.", file=sys.stderr)
sys.exit(44)
