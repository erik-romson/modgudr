#!/usr/bin/env python3
"""A fake `launchctl` (step 12): the probe's `launchctl list` must never reach launchd."""

import json
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
with open(HERE / "fake-log.jsonl", "a", encoding="utf-8") as handle:
    entry = {"tool": "launchctl", "argv": sys.argv[1:], "cwd": os.getcwd(), "env": dict(os.environ)}
    handle.write(json.dumps(entry) + "\n")
print("PID\tStatus\tLabel")
sys.exit(0)
